CC      = gcc
NVCC    = nvcc

# host code (main.c, ksw.c, ...) — ใช้ชุดเดียวกับ Makefile.sycl ทุกตัว
# ต่างกันแค่ -I ของ CUDA (ไม่มีผลกับโค้ดที่ได้)
HOST_CFLAGS = -Wall -Wextra -O2 -g
CFLAGS      = $(HOST_CFLAGS) -I$(CUDA_HOME)/include

NVFLAGS = -O2 -lineinfo -Xcompiler -O2 \
  -gencode arch=compute_70,code=sm_70 \
  -gencode arch=compute_80,code=sm_80 \
  -gencode arch=compute_86,code=sm_86

SRCS_C  = bwa_build.c fm_index.c bwa_smem.c ksw.c
SRCS_CU = bwa_sw.cu

TARGET   = sw_cuda
MAIN_OBJ = main_cuda.o          # ★ แยกชื่อจากฝั่ง SYCL (main_sycl.o)

OBJS = $(SRCS_C:.c=.o) $(SRCS_CU:.cu=.o)

.PHONY: all run clean rebuild

all: $(TARGET)

libbwa.a: $(OBJS)
	ar rcs $@ $^

run: $(TARGET)
	./$(TARGET)

$(TARGET): $(MAIN_OBJ) $(OBJS)
	$(NVCC) -o $@ $^ -lz

$(MAIN_OBJ): main.c bwa.h
	$(CC) $(CFLAGS) -c -o $@ $<

%.o: %.c bwa.h
	$(CC) $(CFLAGS) -c -o $@ $<

%.o: %.cu bwa.h
	$(NVCC) $(NVFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) $(MAIN_OBJ) main.o libbwa.a $(TARGET)

rebuild: clean all