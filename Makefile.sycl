# ==== Makefile สำหรับ SYCL version ====
# ใช้:  make                          -> build sw_sycl (generic, รันได้ทั้ง NVIDIA/AMD)
#       make ACPP_TARGETS=cuda:sm_86  -> build เฉพาะ GPU (ไม่มี JIT ตอนรัน)
#       make run / clean / rebuild

# ---- compiler ----
CC   = gcc
ACPP = acpp

# ---- flags ----
ACPP_TARGETS ?= generic
ACPP_FLAGS    = -O3 --acpp-targets=$(ACPP_TARGETS)
# host code — ชุดเดียวกับ Makefile.cuda ทุกตัว ต่างกันแค่ -DUSE_SYCL
HOST_CFLAGS   = -Wall -Wextra -O2 -g
CFLAGS        = $(HOST_CFLAGS) -DUSE_SYCL     # ★ ให้ main.c เลือก SYCL
LDLIBS        = -lz

# ---- ไฟล์ (★ object ชื่อไม่ซ้ำกับฝั่ง CUDA) ----
TARGET   = sw_sycl
MAIN_OBJ = main_sycl.o
CPP_OBJ  = bwa_sw_sycl.o
KSW_OBJ  = ksw_sycl.o
OBJS     = $(MAIN_OBJ) $(CPP_OBJ) $(KSW_OBJ)

all: $(TARGET)

# ---- link ด้วย acpp (มี SYCL runtime) ----
$(TARGET): $(OBJS)
	$(ACPP) $(OBJS) $(LDLIBS) -o $(TARGET)

# ---- compile main.c ด้วย gcc ----
$(MAIN_OBJ): main.c bwa.h
	$(CC) $(CFLAGS) -c main.c -o $(MAIN_OBJ)

# ---- compile ksw.c (CPU reference จาก BWA) ----
$(KSW_OBJ): ksw.c ksw.h
	$(CC) $(HOST_CFLAGS) -c ksw.c -o $(KSW_OBJ)

# ---- compile SYCL ด้วย acpp ----
$(CPP_OBJ): bwa_sw_sycl.cpp bwa.h
	$(ACPP) $(ACPP_FLAGS) -c bwa_sw_sycl.cpp -o $(CPP_OBJ)

run: $(TARGET)
	./$(TARGET)

clean:
	rm -f $(OBJS) $(TARGET)

rebuild: clean all

.PHONY: all run clean rebuild