# ==== Makefile สำหรับ Own_BWA (SYCL version) ====
# ใช้:  make          → build sw_sycl
#       make run      → build แล้วรันเลย
#       make clean    → ลบ .o + binary
#       make rebuild  → clean แล้ว build ใหม่หมด

# ---- compiler ----
CC   = gcc
ACPP = acpp

# ---- flags ----
ACPP_FLAGS = -O3 --acpp-targets=generic
LDLIBS     = -lz

# ---- ไฟล์ ----
TARGET   = sw_sycl
C_SRC    = main.c
CPP_SRC  = bwa_sw_sycl.cpp
C_OBJ    = $(C_SRC:.c=.o)
CPP_OBJ  = $(CPP_SRC:.cpp=.o)
KSW_OBJ  = ksw.o                      # ★ เพิ่ม
OBJS     = $(C_OBJ) $(CPP_OBJ) $(KSW_OBJ)   # ★ เพิ่ม KSW_OBJ

# ---- default: build ----
all: $(TARGET)

# ---- link: ใช้ acpp เป็น linker (มี SYCL runtime) ----
$(TARGET): $(OBJS)
	$(ACPP) $(OBJS) $(LDLIBS) -o $(TARGET)

# ---- compile main.c ด้วย gcc ----
$(C_OBJ): $(C_SRC)
	$(CC) -c $(C_SRC) -o $(C_OBJ)
# ---- compile ksw.c (CPU reference จาก BWA) ----
$(KSW_OBJ): ksw.c ksw.h
	$(CC) -O2 -c ksw.c -o $(KSW_OBJ)
# ---- compile SYCL ด้วย acpp ----
$(CPP_OBJ): $(CPP_SRC)
	$(ACPP) $(ACPP_FLAGS) -c $(CPP_SRC) -o $(CPP_OBJ)

# ---- build แล้วรันเลย ----
run: $(TARGET)
	./$(TARGET)

# ---- ลบ .o + binary ----
clean:
	rm -f $(OBJS) $(TARGET)

# ---- clean แล้ว build ใหม่หมด ----
rebuild: clean all

.PHONY: all run clean rebuild